              <mxPoint x="460" y="520" />
              <mxPoint x="1100" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_mem_orch" edge="1" parent="1" source="mem0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#22A06B;" target="orch" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="520" />
              <mxPoint x="1300" y="560" />
            </Array>
