        <mxCell id="oc_adapter" value="&lt;b&gt;.opencode/agents/&lt;/b&gt;&lt;br&gt;OpenCode Runtime Adapter / Executable Agent Profiles&lt;br&gt;&lt;b&gt;同步链：&lt;/b&gt;drawio → framework-config → .opencode/agents（当前为手工同步）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
