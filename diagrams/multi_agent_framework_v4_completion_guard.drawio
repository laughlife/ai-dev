<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="ChatGPT" compressed="false">
  <diagram id="main-v3" name="01-多Agent主工作流">
    <mxGraphModel dx="2600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&amp;lt;b&amp;gt;多 Agent 多项目开发执行框架（v4：Completion Guard + 独立并行 Lane）&amp;lt;/b&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=28;fontStyle=1;fontColor=#163A63;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="主工作空间：D:\ai-dev\　｜　架构源：v4 machine metadata　｜　Completion Gate　｜　Lane Scheduler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=14;fontColor=#486581;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="82" width="1740" height="38" as="geometry" />
        </mxCell>
        <mxCell id="workspace" value="&lt;b&gt;主工作空间 / Framework Root：D:\ai-dev\&lt;/b&gt;&lt;br&gt;&lt;br&gt;根 Git 只管理框架资产：流程图、docs、Agent 定义、模板、框架配置等。&lt;br&gt;业务项目目录全部加入根 .gitignore；每个业务项目拥有自己的独立 Git 仓库。&lt;br&gt;&lt;b&gt;项目：&lt;/b&gt;ruoyi-vue-pro / yudao-ui-admin-vue3 / xxl-job / nyamtn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="150" width="2240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="req" value="&lt;b&gt;需求 / 项目目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;产品需求、业务目标、功能描述、约束、验收条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="350" width="560" height="125" as="geometry" />
        </mxCell>
        <mxCell id="mem0" value="&lt;b&gt;Mem0 / 长期记忆&lt;/b&gt;&lt;br&gt;&lt;br&gt;所有 Agent 可读&lt;br&gt;&lt;b&gt;仅主控 / Memory Agent 可写&lt;/b&gt;&lt;br&gt;保存长期知识、历史决策、稳定约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="350" width="560" height="125" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;MCP / 工具能力层&lt;/b&gt;&lt;br&gt;&lt;br&gt;MySQL MCP / Mem0 MCP / Files / Git / Shell / Logs / Search / HTTP / OpenAPI&lt;br&gt;&lt;b&gt;MCP 提供能力，不承担 Agent 临时通讯。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1860" y="350" width="560" height="125" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="&lt;b&gt;总主控 / Global Orchestrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：GPT-6 Sol Fast（极高）&lt;/b&gt;&lt;br&gt;职责：理解最终目标、跨项目路由、维护全局任务、调用 Planner / Project Session / Governance、汇总结果、控制闭环&lt;br&gt;&lt;b&gt;会话：长期复用；达到换代阈值时由 Lifecycle Agent 执行 checkpoint + 新会话换代。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="590" width="1160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lane_analysis" value="&lt;b&gt;分析 / 规划层&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFCFF;strokeColor=#D7E3F1;strokeWidth=1;dashed=1;fontSize=12;fontColor=#486581;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="820" width="1530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="lane_govern" value="&lt;b&gt;治理 / 运行时层&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFCFF;strokeColor=#D7E3F1;strokeWidth=1;dashed=1;fontSize=12;fontColor=#486581;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1740" y="820" width="710" height="390" as="geometry" />
        </mxCell>
        <mxCell id="reader" value="&lt;b&gt;Project Reader / 项目读取代理（每项目 1 个）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;职责：持续读取该项目代码、文件、日志、Git diff、数据库只读信息；输出结构化上下文&lt;br&gt;&lt;b&gt;生命周期：长期复用，不再一次读取一次销毁。&lt;/b&gt;&lt;br&gt;目的：提高同项目重复读取时的上下文与缓存命中率。&lt;br&gt;达到换代阈值后：Lifecycle Agent → Reader Checkpoint → 新一代 Reader。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="890" width="700" height="245" as="geometry" />
        </mxCell>
        <mxCell id="planner" value="&lt;b&gt;Planner / 逻辑分析与任务派发&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：GPT-6 Sol Fast（极高）&lt;/b&gt;&lt;br&gt;职责：复杂分析、任务拆解、DAG、依赖关系、根因分析、选择目标项目、定义验收条件、返工规划&lt;br&gt;&lt;b&gt;生命周期：一个 Feature / Epic；返工期间可继续复用；Feature 结束后关闭。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="890" width="620" height="245" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle" value="&lt;b&gt;Lifecycle Agent / 会话生命周期管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;长期治理 Agent。负责：Session Registry、上下文阈值、checkpoint、换代、归档、恢复。&lt;br&gt;重点管理：Project Main、Project Reader、Feature Executor、Planner。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1790" y="875" width="610" height="150" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;Runtime Registry / 任务与会话账本&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SQLite：tasks.db&lt;/b&gt;&lt;br&gt;task_id / project / role / session_id / generation / status / context_pct / checkpoint / replaced_by&lt;br&gt;作为运行时状态真相源；Mem0 不保存临时 Task State。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1790" y="1045" width="610" height="130" as="geometry" />
        </mxCell>
        <mxCell id="task_bus" value="&lt;b&gt;Task Bus / Agent 通讯层&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;实现：OpenCode 原生 Task / Subagent + 结构化 JSON Task Envelope&lt;/b&gt;&lt;br&gt;task_id / project / objective / constraints / dependencies / expected_output / status&lt;br&gt;Agent 间临时通讯走这里；不使用 Mem0 当消息队列。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1285" width="1480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="lane_projects" value="&lt;b&gt;项目层：每个项目一个长期 Project Session；代码修改时再创建 Feature Child Session&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFCFF;strokeColor=#D7E3F1;strokeWidth=1;dashed=1;fontSize=12;fontColor=#486581;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="1530" width="2340" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p_java" value="&lt;b&gt;Project Session：ruoyi-vue-pro / 后端&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：GPT-5.6 Sol Fast（高）&lt;/b&gt;&lt;br&gt;&lt;b&gt;D:\ai-dev\ruoyi-vue-pro&lt;/b&gt;&lt;br&gt;职责：Java / Controller / Service / Mapper / SQL / 单测&lt;br&gt;&lt;b&gt;会话：项目主会话长期复用；具体修改使用 Feature Child Session。&lt;/b&gt;&lt;br&gt;需要 DB / API 操作时，不直接跨 Agent 聊天，提交子任务回 Task Bus。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4CAF6A;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="1610" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p_vue" value="&lt;b&gt;Project Session：yudao-ui-admin-vue3 / 前端&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：GPT-5.6 Sol Fast（高）&lt;/b&gt;&lt;br&gt;&lt;b&gt;D:\ai-dev\yudao-ui-admin-vue3&lt;/b&gt;&lt;br&gt;职责：Vue / 页面 / 组件 / API 对接 / 状态管理&lt;br&gt;&lt;b&gt;会话：项目主会话长期复用；具体修改使用 Feature Child Session。&lt;/b&gt;&lt;br&gt;需要 DB / API 操作时，不直接跨 Agent 聊天，提交子任务回 Task Bus。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4CAF6A;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="785" y="1610" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p_xxl" value="&lt;b&gt;Project Session：xxl-job / 任务调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：待定 / 按项目配置&lt;/b&gt;&lt;br&gt;&lt;b&gt;D:\ai-dev\xxl-job&lt;/b&gt;&lt;br&gt;职责：调度服务 / Job / 配置 / 调度接口&lt;br&gt;&lt;b&gt;会话：项目主会话长期复用；具体修改使用 Feature Child Session。&lt;/b&gt;&lt;br&gt;需要 DB / API 操作时，不直接跨 Agent 聊天，提交子任务回 Task Bus。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4CAF6A;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1610" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p_android" value="&lt;b&gt;Project Session：nyamtn / PDA / Android&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：GPT-5.6 Sol Fast（高）&lt;/b&gt;&lt;br&gt;&lt;b&gt;D:\ai-dev\nyamtn&lt;/b&gt;&lt;br&gt;职责：Kotlin / UI / 扫码 / API 调用&lt;br&gt;&lt;b&gt;会话：项目主会话长期复用；具体修改使用 Feature Child Session。&lt;/b&gt;&lt;br&gt;需要 DB / API 操作时，不直接跨 Agent 聊天，提交子任务回 Task Bus。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4CAF6A;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1995" y="1610" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="lane_ops" value="&lt;b&gt;专用能力执行层：DB / API 独立对话&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFCFF;strokeColor=#D7E3F1;strokeWidth=1;dashed=1;fontSize=12;fontColor=#486581;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="2050" width="2000" height="400" as="geometry" />
        </mxCell>
        <mxCell id="dbop" value="&lt;b&gt;DB Operator / 数据库专用子 Agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;数据库：ruoyi-vue-pro&lt;/b&gt;&lt;br&gt;默认：&lt;b&gt;mysql-local&lt;/b&gt;　｜　明确要求服务器环境：&lt;b&gt;mysql-server&lt;/b&gt;&lt;br&gt;&lt;b&gt;模型：[Token Plan] qwen3.8-max&lt;/b&gt;&lt;br&gt;Reader 可做 SELECT / SHOW / EXPLAIN；&lt;b&gt;INSERT / UPDATE / DELETE / DDL / 备份只走 DB Operator&lt;/b&gt;&lt;br&gt;生命周期：一个 DB 变更集合 / Feature；高风险操作前先备份；PASS 后关闭。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="2140" width="820" height="230" as="geometry" />
        </mxCell>
        <mxCell id="apirun" value="&lt;b&gt;API Runner / 接口调用与联调专用子 Agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;工具：Shell / curl / HTTP / OpenAPI&lt;br&gt;职责：真实请求、请求参数、响应验证、接口回归、联调定位。&lt;br&gt;&lt;b&gt;API Runner 只负责调用和验证，不修改业务代码。&lt;/b&gt;&lt;br&gt;接口代码修改回对应 Project Feature Session；生命周期：一次联调 / 回归轮次，完成即关闭。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1390" y="2140" width="820" height="230" as="geometry" />
        </mxCell>
        <mxCell id="result_bus" value="&lt;b&gt;Execution Result Bus / 执行结果汇聚&lt;/b&gt;&lt;br&gt;Git Diff / Changed Files / DB Change / API Result / Build Result / Logs / Risks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="2530" width="1480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="test" value="&lt;b&gt;Test Runner / 验证执行器&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：DeepSeek-V4.1-Flash 或其他快速稳定模型&lt;/b&gt;&lt;br&gt;职责：编译、单测、构建、接口回归、SQL EXPLAIN、日志检查、基础回归&lt;br&gt;&lt;b&gt;会话：每一轮测试新建，完成即关闭。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="2710" width="1160" height="135" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;Reviewer / 独立验收代理&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;模型：GPT-5.6 Sol（高）&lt;/b&gt;&lt;br&gt;输入：原需求 + 验收标准 + Git Diff + DB 变化 + API/Test 结果&lt;br&gt;输出：PASS / FIX / REWORK；检查遗漏、副作用、一致性。&lt;br&gt;&lt;b&gt;每轮验收新建会话，避免继承 Executor 的偏见。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F3;strokeColor=#E5484D;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="2940" width="1050" height="155" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="验收结果？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#8A4B08;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1900" y="2960" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="final_summary" value="&lt;b&gt;主控汇总&lt;/b&gt;&lt;br&gt;&lt;br&gt;汇总变更、测试、DB/API结果、风险、待办；确认 Feature 状态。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="3210" width="480" height="115" as="geometry" />
        </mxCell>
        <mxCell id="docs" value="&lt;b&gt;Documentation Agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;更新 docs / architecture / API / DB / CHANGELOG / checkpoint。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="3210" width="480" height="115" as="geometry" />
        </mxCell>
        <mxCell id="memory" value="&lt;b&gt;Memory Agent / Mem0 治理&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GPT-5.6 Sol Fast（高）&lt;/b&gt;&lt;br&gt;仅写 Reviewer 已通过且长期有效的信息。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="3210" width="480" height="115" as="geometry" />
        </mxCell>
        <mxCell id="done" value="&lt;b&gt;交付完成 / Feature Closed&lt;/b&gt;&lt;br&gt;&lt;br&gt;关闭一次性会话；保留 Project Main / Project Reader；Registry 标记 PASS / ARCHIVED。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1960" y="3210" width="480" height="115" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;核心规则&lt;/b&gt;&lt;br&gt;① Project Reader = 每项目 1 个长期 Reader，由 Lifecycle 管理换代，以提高缓存命中。　② DB 只读可由 Reader；DB 写/DDL/备份只走 DB Operator。　③ 真实 API 调用只走 API Runner；接口代码修改回 Project Feature Session。&lt;br&gt;④ Agent 临时通讯走 Task Bus + JSON；Mem0 只放长期知识。　⑤ 根 Git 只管理框架；4 个业务项目由各自 Git 管理。　⑥ Reviewer 每轮新建，禁止执行 Agent 自评。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="3390" width="2200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e_req_orch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3B82F6;" edge="1" parent="1" source="req" target="orch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="520" />
              <mxPoint x="1100" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_mem_orch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#22A06B;" edge="1" parent="1" source="mem0" target="orch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="520" />
              <mxPoint x="1300" y="560" />
            </Array>
