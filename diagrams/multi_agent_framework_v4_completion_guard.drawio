        <mxCell id="title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=28;fontStyle=1;fontColor=#163A63;align=center;verticalAlign=middle;" value="&amp;lt;b&amp;gt;多 Agent 多项目开发执行框架（v4：Completion Guard + 独立并行 Lane）&amp;lt;/b&amp;gt;" vertex="1">
          <mxGeometry height="60" width="1760" x="420" y="20" as="geometry" />
