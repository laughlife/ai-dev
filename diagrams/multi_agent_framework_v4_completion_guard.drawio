  <diagram id="lifecycle-v3" name="02-会话生命周期与调用路由">
    <mxGraphModel dx="2600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="&lt;b&gt;会话生命周期、Reader 缓存策略、数据库与接口调用路由&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=28;fontStyle=1;fontColor=#163A63;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="25" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="重点：项目 Reader 不再即用即丢；每个项目维持 1 个 Reader，由 Lifecycle Agent 负责换代与恢复。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=14;fontColor=#486581;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="1700" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c_orch" value="&lt;b&gt;Global Orchestrator&lt;/b&gt;&lt;br&gt;&lt;b&gt;GPT-6 Sol Fast（极高）&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：长期&lt;br&gt;跨项目调度，不直接承担大量读取/改码&lt;br&gt;≥70%：checkpoint 后代际换新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="170" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_proj" value="&lt;b&gt;Project Session（每项目 1 个）&lt;/b&gt;&lt;br&gt;&lt;b&gt;项目模型&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：长期、允许代际轮换&lt;br&gt;维护项目任务与局部上下文&lt;br&gt;具体修改使用 Feature Child Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_reader" value="&lt;b&gt;Project Reader（每项目 1 个）&lt;/b&gt;&lt;br&gt;&lt;b&gt;DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;生命周期：长期复用&lt;/b&gt;&lt;br&gt;持续读取同一项目，提高重复读取与缓存命中&lt;br&gt;换代由 Lifecycle Agent 管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="170" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_planner" value="&lt;b&gt;Planner&lt;/b&gt;&lt;br&gt;&lt;b&gt;GPT-6 Sol Fast（极高）&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：一个 Feature / Epic&lt;br&gt;返工期间继续复用&lt;br&gt;Feature 关闭后结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1580" y="170" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_life" value="&lt;b&gt;Lifecycle Agent&lt;/b&gt;&lt;br&gt;&lt;b&gt;DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：长期治理&lt;br&gt;管理 Main / Reader / Planner / Executor&lt;br&gt;checkpoint / generation / archive / restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2070" y="170" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_exec" value="&lt;b&gt;Feature Executor&lt;/b&gt;&lt;br&gt;&lt;b&gt;项目对应执行模型&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：一个 Feature / Branch&lt;br&gt;同一 Feature 修复可复用&lt;br&gt;Reviewer PASS 后关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="450" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_db" value="&lt;b&gt;DB Operator&lt;/b&gt;&lt;br&gt;&lt;b&gt;qwen3.8-max&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：一个 DB 变更集合 / Feature&lt;br&gt;DB 写、DDL、备份专用&lt;br&gt;高风险前先备份" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="450" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_api" value="&lt;b&gt;API Runner&lt;/b&gt;&lt;br&gt;&lt;b&gt;DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：一次联调 / 回归轮次&lt;br&gt;真实 HTTP / curl / OpenAPI 调用&lt;br&gt;完成即关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="450" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_test" value="&lt;b&gt;Test Runner&lt;/b&gt;&lt;br&gt;&lt;b&gt;DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：一轮验证&lt;br&gt;编译 / 单测 / 构建 / 回归&lt;br&gt;完成即关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1580" y="450" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_rev" value="&lt;b&gt;Reviewer&lt;/b&gt;&lt;br&gt;&lt;b&gt;GPT-5.6 Sol（高）&lt;/b&gt;&lt;br&gt;&lt;br&gt;生命周期：每轮验收新会话&lt;br&gt;保持独立，不继承 Executor 推理&lt;br&gt;PASS / FIX / REWORK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F3;strokeColor=#E5484D;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2070" y="450" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c_docs" value="&lt;b&gt;Documentation Agent&lt;/b&gt;&lt;br&gt;&lt;b&gt;DeepSeek-V4.1-Flash&lt;/b&gt;&lt;br&gt;&lt;br&gt;事件驱动：PASS / API契约变化 / DB结构变化 / 架构变化&lt;br&gt;会话可短期；文档本身是持久资产。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="740" width="760" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c_mem" value="&lt;b&gt;Memory Agent&lt;/b&gt;&lt;br&gt;&lt;b&gt;GPT-5.6 Sol Fast（高）&lt;/b&gt;&lt;br&gt;&lt;br&gt;事件驱动：Reviewer PASS 后&lt;br&gt;只写长期有效信息到 Mem0；临时 Task State 禁止写入。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1450" y="740" width="760" height="145" as="geometry" />
        </mxCell>
        <mxCell id="reader_policy" value="&lt;b&gt;Project Reader 专用生命周期策略（重要）&lt;/b&gt;&lt;br&gt;&lt;br&gt;每个项目固定维护一个 Reader：例如 ruoyi-vue-pro-READER-001、nyamtn-READER-001。&lt;br&gt;同项目连续读取、定位、二次追踪都复用当前 Reader，使模型对项目结构保持热状态，提高缓存命中。&lt;br&gt;换代时不是“读取一次就丢”，而是：Lifecycle Agent → 生成 Reader Checkpoint（项目地图 / 常读路径 / 当前关注模块 / 未完成读取任务）→ 新建下一代 Reader → 恢复。&lt;br&gt;&lt;b&gt;Reader 不修改代码、不写 Mem0；它只负责项目级持续读取和结构化上下文输出。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="980" width="2180" height="190" as="geometry" />
        </mxCell>
        <mxCell id="route_db" value="&lt;b&gt;数据库调用路由&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 表结构 / SHOW / SELECT / EXPLAIN / 只读核对 → 对应项目 Project Reader 可调用 MySQL MCP。&lt;br&gt;2. INSERT / UPDATE / DELETE / CREATE / ALTER / DROP / TRUNCATE / INDEX / 备份 → &lt;b&gt;DB Operator 专用对话&lt;/b&gt;。&lt;br&gt;3. 默认连接 mysql-local；只有任务明确指定服务器开发环境时才使用 mysql-server。&lt;br&gt;4. Project Executor 不直接执行高风险 DB 操作，提交 DB 子任务到 Task Bus。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="1250" width="1100" height="210" as="geometry" />
        </mxCell>
        <mxCell id="route_api" value="&lt;b&gt;接口调用路由&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Controller / DTO / 前端调用代码 / Android 调用代码修改 → 对应项目 Feature Executor。&lt;br&gt;2. 真实 HTTP 请求、curl、请求参数、响应验证、接口回归、联调 → &lt;b&gt;API Runner 专用对话&lt;/b&gt;。&lt;br&gt;3. API Runner 发现代码问题 → 返回 Result → Planner / Project Session → 对应 Executor 修改。&lt;br&gt;4. 前端 / Android 不直接跨项目聊天修改后端，统一经 Task Bus 派发。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1250" width="1100" height="210" as="geometry" />
        </mxCell>
        <mxCell id="rotate_title" value="&lt;b&gt;会话超限 / 换代策略（建议阈值，可直接在流程图中调整）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="130" y="1540" width="2340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;&amp;lt; 60%&lt;/b&gt;&lt;br&gt;&lt;br&gt;同项目 / 同 Feature / 同角色：继续复用。&lt;br&gt;Reader 尤其优先复用。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="1640" width="520" height="145" as="geometry" />
        </mxCell>
        <mxCell id="r2x" value="&lt;b&gt;60%–70%&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lifecycle Agent 准备 checkpoint；不再派发大型新任务。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="1640" width="520" height="145" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;≥ 70%&lt;/b&gt;&lt;br&gt;&lt;br&gt;完成当前原子步骤后换代；旧 Session → ARCHIVED。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1640" width="520" height="145" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;≥ 80%&lt;/b&gt;&lt;br&gt;&lt;br&gt;禁止再派发新任务；强制换代。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1960" y="1640" width="520" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_r1_r2x" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3B82F6;" edge="1" parent="1" source="r1" target="r2x">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r2x_r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3B82F6;" edge="1" parent="1" source="r2x" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r3_r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3B82F6;" edge="1" parent="1" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rotation_flow" value="&lt;b&gt;换代恢复流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lifecycle Agent 发现阈值 → 写 checkpoint → 更新 tasks.db → 新建下一代 Session → 加载 active task + checkpoint + 项目文档 + Git 状态 + 必要 Mem0 → 继续。&lt;br&gt;&lt;b&gt;Project Main / Project Reader 是长期角色，但 Session 本身允许代际轮换。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="1850" width="1960" height="130" as="geometry" />
        </mxCell>
        <mxCell id="naming" value="&lt;b&gt;推荐 Session 命名&lt;/b&gt;&lt;br&gt;&lt;br&gt;项目主会话：&amp;lt;project&amp;gt;-MAIN-NNN&lt;br&gt;项目 Reader：&amp;lt;project&amp;gt;-READER-NNN&lt;br&gt;Feature Executor：&amp;lt;project&amp;gt;-&amp;lt;role&amp;gt;-&amp;lt;feature&amp;gt;-NNN&lt;br&gt;Reviewer：&amp;lt;project&amp;gt;-REVIEW-&amp;lt;task&amp;gt;-NNN&lt;br&gt;示例：WMS-READER-003 / WMS-JAVA-LOCATION-002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="2070" width="1020" height="205" as="geometry" />
        </mxCell>
        <mxCell id="states" value="&lt;b&gt;Task / Session 状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;NEW → RUNNING → WAITING_REVIEW → PASS → ARCHIVED&lt;br&gt;　　　　　　　　　　　↘ FIX / REWORK → RUNNING&lt;br&gt;&lt;br&gt;Runtime Registry 是运行时真相源；Mem0 不是任务状态库。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="2070" width="1020" height="205" as="geometry" />
        </mxCell>
        <mxCell id="footer2" value="&lt;b&gt;一句话规则：&lt;/b&gt;项目主会话长期、项目 Reader 长期、Feature Executor 按功能、API/Test/Reviewer 短期；DB 写操作专用；Lifecycle Agent 统一管理换代。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="2380" width="2080" height="95" as="geometry" />
        </mxCell>
        <mxCell id="arch-runtime-team-execution-coordinator" parent="1" value="team-execution-coordinator" vertex="1" data-arch-kind="runtime_component" data-arch-id="team-execution-coordinator" data-component-kind="team-execution-coordinator"><mxGeometry x="20" y="11020" width="1" height="1" as="geometry" /></mxCell>
    </root>
    </mxGraphModel>
  </diagram>
  <diagram id="workspace-git-v3" name="03-D_ai-dev工作空间与Git管理">
    <mxGraphModel dx="2600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="&lt;b&gt;D:\ai-dev\ 主工作空间与 Git 管理框架&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=28;fontStyle=1;fontColor=#163A63;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="25" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="目标：根仓库只管理多 Agent 框架资产；所有业务项目独立 Git；OpenCode / Agent 从 D:\ai-dev\ 统一路由项目。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=14;fontColor=#486581;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="1740" height="38" as="geometry" />
        </mxCell>
        <mxCell id="rootrepo" value="&lt;b&gt;Framework Root Repository：D:\ai-dev\&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;根 Git 只管理框架，不管理业务项目源码。&lt;/b&gt;&lt;br&gt;建议跟踪：README.md / diagrams/ / docs/ / agents/ / templates/ / framework-config/&lt;br&gt;建议不跟踪：业务项目目录 / runtime/ / .backups/ / 临时日志。&lt;br&gt;OpenCode 主工作空间从 D:\ai-dev\ 启动，Global Orchestrator 按项目路径路由。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="180" width="2200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tree" value="&lt;b&gt;推荐目录结构&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face='monospace'&gt;D:\ai-dev\&lt;br&gt;├─ .git\　　　　　　　　　　　← 框架根仓库&lt;br&gt;├─ .gitignore&lt;br&gt;├─ README.md&lt;br&gt;├─ diagrams\　　　　　　　　　← .drawio 流程图&lt;br&gt;├─ docs\　　　　　　　　　　　← 架构 / 规范 / 决策 / API / DB 文档&lt;br&gt;├─ agents\　　　　　　　　　　← Agent 定义 / Prompt / Policy&lt;br&gt;├─ templates\　　　　　　　　← Task Envelope / Checkpoint / 文档模板&lt;br&gt;├─ runtime\　　　　　　　　　 ← tasks.db / 临时状态（建议忽略）&lt;br&gt;├─ .backups\　　　　　　　　← DB / 配置临时备份（建议忽略）&lt;br&gt;│&lt;br&gt;├─ ruoyi-vue-pro\　　　　　　← 独立 Git；根仓库忽略&lt;br&gt;├─ yudao-ui-admin-vue3\　　　← 独立 Git；根仓库忽略&lt;br&gt;├─ xxl-job\　　　　　　　　　← 独立 Git；根仓库忽略&lt;br&gt;└─ nyamtn\　　　　　　　　　 ← 独立 Git；已移动到 D:\ai-dev\nyamtn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="440" width="1140" height="630" as="geometry" />
        </mxCell>
        <mxCell id="gitignore" value="&lt;b&gt;根 D:\ai-dev\.gitignore 建议&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face='monospace'&gt;/ruoyi-vue-pro/&lt;br&gt;/yudao-ui-admin-vue3/&lt;br&gt;/xxl-job/&lt;br&gt;/nyamtn/&lt;br&gt;&lt;br&gt;/runtime/&lt;br&gt;/.backups/&lt;br&gt;*.log&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;结果：&lt;/b&gt;根仓库不会 stage / commit 子项目源码；进入任一项目目录后，仍由该项目自己的 .git 正常管理。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1470" y="440" width="990" height="430" as="geometry" />
        </mxCell>
        <mxCell id="git_rules" value="&lt;b&gt;Git 边界规则&lt;/b&gt;&lt;br&gt;&lt;br&gt;① Framework Root：只提交框架流程图、docs、Agent 配置、模板、治理规则。&lt;br&gt;② ruoyi-vue-pro：只在自己的仓库中 commit / branch / diff。&lt;br&gt;③ yudao-ui-admin-vue3：独立仓库。&lt;br&gt;④ xxl-job：独立仓库。&lt;br&gt;⑤ nyamtn：独立仓库，路径固定为 D:\ai-dev\nyamtn。&lt;br&gt;⑥ Global Orchestrator 不允许在根仓库把业务项目源码加入 stage。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F3;strokeColor=#E5484D;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1470" y="920" width="990" height="330" as="geometry" />
        </mxCell>
        <mxCell id="repo1" value="&lt;b&gt;ruoyi-vue-pro&lt;/b&gt;&lt;br&gt;&lt;br&gt;D:\ai-dev\ruoyi-vue-pro&lt;br&gt;&lt;b&gt;独立 .git&lt;/b&gt;&lt;br&gt;对应：Project Main + Project Reader + Feature Executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="1180" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="repo2" value="&lt;b&gt;yudao-ui-admin-vue3&lt;/b&gt;&lt;br&gt;&lt;br&gt;D:\ai-dev\yudao-ui-admin-vue3&lt;br&gt;&lt;b&gt;独立 .git&lt;/b&gt;&lt;br&gt;对应：Project Main + Project Reader + Feature Executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="1180" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="repo3" value="&lt;b&gt;xxl-job&lt;/b&gt;&lt;br&gt;&lt;br&gt;D:\ai-dev\xxl-job&lt;br&gt;&lt;b&gt;独立 .git&lt;/b&gt;&lt;br&gt;对应：Project Main + Project Reader + Feature Executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1180" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="repo4" value="&lt;b&gt;nyamtn / Android&lt;/b&gt;&lt;br&gt;&lt;br&gt;D:\ai-dev\nyamtn&lt;br&gt;&lt;b&gt;独立 .git&lt;/b&gt;&lt;br&gt;对应：Project Main + Project Reader + Feature Executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1960" y="1180" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="&lt;b&gt;持久框架资产（根 Git 跟踪）&lt;/b&gt;&lt;br&gt;&lt;br&gt;diagrams/：流程图与模型/角色配置视图&lt;br&gt;docs/：架构、项目索引、API/DB规范、决策记录&lt;br&gt;agents/：Agent 定义、角色权限、系统提示词&lt;br&gt;templates/：Task Envelope、Result Envelope、Checkpoint 模板&lt;br&gt;README.md：框架入口和使用说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1510" width="920" height="260" as="geometry" />
        </mxCell>
        <mxCell id="oc_adapter" value="&lt;b&gt;.opencode/agents/&lt;/b&gt;&lt;br&gt;OpenCode Runtime Adapter / Executable Agent Profiles&lt;br&gt;&lt;b&gt;同步链：&lt;/b&gt;drawio → framework-config → .opencode/agents（当前为手工同步）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;fontColor=#17324D;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="1785" width="920" height="80" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;运行时资产（根 Git 建议忽略）&lt;/b&gt;&lt;br&gt;&lt;br&gt;runtime/tasks.db：任务与 Session Registry&lt;br&gt;runtime/checkpoints/：短期 checkpoint&lt;br&gt;.backups/：DB / 配置备份&lt;br&gt;临时日志 / 调试输出&lt;br&gt;&lt;br&gt;&lt;b&gt;长期稳定知识最终进入 docs / Mem0；临时状态不进入 Mem0。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1510" width="920" height="260" as="geometry" />
        </mxCell>
        <mxCell id="workspace_flow" value="&lt;b&gt;OpenCode 工作空间路由&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenCode 从 D:\ai-dev\ 启动 → Global Orchestrator 读取 Framework Root → 根据 task.project 选择目标项目路径 → 调用该项目 Project Main / Project Reader → Feature Executor 修改目标项目 → Git Diff 只来自目标项目自己的仓库。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1870" width="2040" height="140" as="geometry" />
        </mxCell>
        <mxCell id="footer3" value="&lt;b&gt;最终原则：&lt;/b&gt;一个主工作空间、一个框架根仓库、多个独立业务 Git 仓库；框架管理“怎么协作”，业务仓库管理“具体代码”。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#22A06B;strokeWidth=2;fontSize=13;fontColor=#17324D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="2080" width="1880" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
