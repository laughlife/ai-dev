l=1;fillColor=#FFF7E6;strokeColor=#F59E0B;strokeWidth=1;fontSize=11;fontColor=#17324D;align=left;verticalAlign=middle;spacing=6;"><mxGeometry x="1800" y="2450" width="500" height="60" as="geometry" /></mxCell><mxCell id="arch-policy-execution-complete" parent="1" value="all required nodes terminal-success; no READY/RUNNING/BLOCKED/FAILED; scheduler inactive" vertex="1" data-arch-kind="policy" data-arch-id="execution-complete"><mxGeometry x="20" y="10047" width="1" height="1" as="geometry" /></mxCell><mxCell id="arch-policy-delivery-complete" parent="1" value="reviewer PASS; deliverables/docs/memory/evidence complete; no active child" vertex="1" data-arch-kind="policy" data-arch-id="delivery-complete"><mxGeometry x="20" y="10048" width="1" height="1" as="geometry" /></mxCell><mxCell id="arch-policy-final-report" parent="1" value="delivery gate is DELIVERY_COMPLETE; otherwise continue or report blocked" vertex="1" data-arch-kind="policy" data-arch-id="final-report"><mxGeometry x="20" y="10049" width="1" height="1" as="geometry" /></mxCell><mxCell id="arch-policy-resource-lock" parent="1" value="intersecting resources serialize; missing write scope defaults to project:&lt;pid&gt;:write" vertex="1" data-arch-kind="policy" data-arch-id="resource-lock"><mxGeometry x="20" y="10050" width="1" height="1" as="geometry" /></mxCell><mxCell id="arch-lifecycle-thresholds" parent="1" value="60/70/80 context lifecycle" vertex="1" data-arch-kind="lifecycle" data-arch-id="context-rotation" data-continue-below="60" data-checkpoint-from="60" data-checkpoint-to="70" data-rotate-at="70" data-hard-stop-at="80"><mxGeometry x="20" y="20000" width="1" height="1" as="geometry" /></mxCell></root>
