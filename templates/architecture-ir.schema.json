{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev.local/templates/architecture-ir.schema.json",
  "title": "AI Dev Architecture IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "source", "agents", "projects", "routes", "lifecycle", "runtime_components", "completion_guards", "execution_lanes", "relationships"],
  "properties": {
    "ir_version": { "const": 1 },
    "source": { "type": "object" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "model_key", "lifecycle"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "model_key": { "type": "string" },
          "lifecycle": { "type": "string" },
          "runtime_mode": { "enum": ["primary", "all", "subagent"] }
        },
        "additionalProperties": false
      }
    },
    "projects": { "type": "array" },
    "routes": { "type": "array" },
    "lifecycle": { "type": "object" },
    "runtime_components": { "type": "array" },
    "completion_guards": { "type": "array" },
    "execution_lanes": { "type": "array" },
    "relationships": { "type": "array" }
  }
}
